{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rida",
  "compatibility_date": "2026-03-15",
  "main": "./.output/server/index.mjs",
  "assets": {
    "directory": "./.output/public/",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "preview": {}
  }
}